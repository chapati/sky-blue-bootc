[Unit]
Description=Sky Blue system setup service
Requires=ublue-system-setup.service
After=ublue-system-setup.service
Before=network.target systemd-user-sessions.service

[Service]
Type=oneshot
# /usr/bin/script hack fixes the issue when output of subprocesses is not associated with the service
# https://serverfault.com/questions/1143567/why-doesnt-systemd-capture-output-from-subprocesses-of-a-user-service-written-i
ExecStart=/usr/bin/script -c "/usr/bin/nu --config /usr/libexec/sblue/config.nu /usr/libexec/sblue/sblue-system-setup.nu --base /usr/libexec/sblue" /dev/null
# Do not kill spawned children
KillMode=process 
# Do not restart service after exit
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
