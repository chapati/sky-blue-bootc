[Unit]
Description=Sky Blue system setup service
Requires=ublue-system-setup.service
After=ublue-system-setup.service
Before=network.target systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/bin/nu --config /usr/libexec/sblue/config.nu /usr/libexec/sblue/sblue-system-setup.nu --base /usr/libexec/sblue
# Do not kill spawned children
KillMode=process 
# Do not restart service after exit
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
