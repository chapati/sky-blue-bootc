[Unit]
Description=Sky Blue user setup service
Requires=ublue-user-setup.service
After=ublue-user-setup.service
ConditionUser=!@system

[Service]
Type=simple
ExecStart=/usr/bin/nu --config /usr/libexec/sblue/config.nu /usr/libexec/sblue/sblue-user-setup.nu --base /usr/libexec/sblue
# Do not kill spawned children
KillMode=process 
# Do not restart service after exit
RemainAfterExit=yes

[Install]
WantedBy=graphical-session.target
