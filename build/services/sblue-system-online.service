[Unit]
Description=Sky Blue online system setup service
Requires=network-online.target ublue-system-setup.service
After=network-online.target ublue-system-setup.service

[Service]
Type=simple
ExecStart=/usr/bin/nu --config /usr/libexec/sblue/config.nu /usr/libexec/sblue/sblue-system-online.nu
# Do not kill spawned children
KillMode=process 
# Do not restart service after exit
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
